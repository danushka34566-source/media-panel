# ============================================================================
# PANEL / VERCEL - CORE
# ============================================================================
NEXT_PUBLIC_DOMAIN=https://your-app.vercel.app
NEXT_PUBLIC_DOMAIN_SHARE=
NEXT_PUBLIC_LOCALE=en-us
NEXT_PUBLIC_META_TITLE=MEDIA
NEXT_PUBLIC_META_DESCRIPTION=Your private media library
NEXT_PUBLIC_NAV_TITLE=
NEXT_PUBLIC_NAV_CAPTION=
NEXT_PUBLIC_PAGE_ABOUT=
AUTH_SECRET=replace-with-a-long-random-secret

# Database
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require
# Provider and SSL mode are automatic from POSTGRES_URL. Supabase URLs use
# compatibility mode and Neon URLs keep strict TLS. Set this optional value to
# 1 or 0 only to override automatic detection.
DISABLE_POSTGRES_SSL=
MEDIA_ID_FORWARDING_TABLE=

# ============================================================================
# STORAGE - DRIVE HAS PRIORITY WHEN BOTH PROVIDERS ARE COMPLETE
# ============================================================================
# Drive gateway
DRIVE_STORAGE_BASE_URL=https://your-drive-domain.com/storage
DRIVE_STORAGE_API_KEY=replace-with-drive-project-api-key
NEXT_PUBLIC_DRIVE_STORAGE_PROJECT_ID=replace-with-drive-project-id
NEXT_PUBLIC_DRIVE_STORAGE_BUCKET=your-bucket
NEXT_PUBLIC_DRIVE_MULTIPART_THRESHOLD_BYTES=0
NEXT_PUBLIC_DRIVE_MULTIPART_PART_SIZE_BYTES=8388608
NEXT_PUBLIC_DRIVE_MULTIPART_CONCURRENCY=8
NEXT_PUBLIC_DRIVE_MULTIPART_PART_URL_LOOKAHEAD=9

# Cloudflare R2 fallback
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
NEXT_PUBLIC_CLOUDFLARE_R2_ACCOUNT_ID=
NEXT_PUBLIC_CLOUDFLARE_R2_BUCKET=
NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_DOMAIN=

# ============================================================================
# BACKEND ORCHESTRATOR AND BACKEND PROCESSOR
# ============================================================================
# Panel / Vercel values. Presence of the URL and shared secret automatically
# enables the Backend Orchestrator; there is no separate enabled flag.
BACKEND_ORCHESTRATOR_BASE_URL=https://your-orchestrator.workers.dev
BACKEND_ORCHESTRATOR_SHARED_SECRET=replace-with-a-long-random-secret
BACKEND_PROCESSOR_SHARED_SECRET=replace-with-a-separate-long-random-secret
AUTOMATION_API_SECRET=replace-with-a-long-random-secret

# Cloudflare deployment bootstrap only. The Cloudflare build needs this panel
# URL plus BACKEND_ORCHESTRATOR_SHARED_SECRET from above.
MEDIA_PANEL_BASE_URL=https://your-app.vercel.app

# Generated Backend Orchestrator runtime bindings. The panel deployment
# endpoint creates these automatically from the selected storage provider.
DRIVE_STORAGE_PROJECT_ID=replace-with-drive-project-id
DRIVE_STORAGE_BUCKET=your-bucket
R2_PUBLIC_BASE_URL=https://your-public-bucket-domain.r2.dev
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_BUCKET=media
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
UNIQUE_MEDIA_NAMES=1

# Backend Processor host only. It uses BACKEND_ORCHESTRATOR_BASE_URL and
# BACKEND_PROCESSOR_SHARED_SECRET from above.
BACKEND_PROCESSOR_ID=
RUN_ONCE=0

# Backend Orchestrator runtime defaults. The panel deployment endpoint supplies
# these automatically. Live values are managed by a super admin in Configuration.
REGISTER_BATCH_SIZE=2
MAX_REGISTER_PASSES=2
STALE_PROCESSING_MINUTES=2
STALE_REGISTRATION_MINUTES=5
REGISTRATION_HISTORY_DAYS=14
BACKEND_PROCESSOR_POLL_INTERVAL_MS=5000
BACKEND_PROCESSOR_IDLE_INTERVAL_MS=5000
BACKEND_PROCESSOR_HEARTBEAT_INTERVAL_MS=5000
BACKEND_PROCESSOR_CLAIM_LIMIT=1

# ============================================================================
# AUTHENTICATION AND NOTIFICATIONS
# ============================================================================
# Google OAuth callback:
# https://your-app.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret

# Resend email verification and password reset
RESEND_API_KEY=
RESEND_FROM_EMAIL="Media Panel <onboarding@resend.dev>"

# Text.lk SMS verification and 2FA
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=MediaPanel

# ============================================================================
# OPTIONAL SERVICES
# ============================================================================
# Redis / rate limiting
KV_URL=
UPSTASH_REDIS_REST_URL=
EXIF_KV_REST_API_URL=
EXIF_KV_REST_API_TOKEN=

# AI and location services
OPENAI_SECRET_KEY=
OPENAI_BASE_URL=
AI_TEXT_AUTO_GENERATED_FIELDS=title,tags,semantic
GOOGLE_PLACES_API_KEY=

# ============================================================================
# MEDIA, PERFORMANCE, AND STATIC GENERATION
# ============================================================================
NEXT_PUBLIC_UNIQUE_MEDIA_NAMES=1
NEXT_PUBLIC_PRESERVE_ORIGINAL_UPLOADS=0
NEXT_PUBLIC_TRANSCODE_VIDEOS_ON_ADD=0
NEXT_PUBLIC_GENERATE_STREAM_DERIVATIVES=0
NEXT_PUBLIC_IMAGE_QUALITY=75
NEXT_PUBLIC_BLUR_DISABLED=0
# Initial defaults for the Admin â†’ Configuration â†’ Performance switches.
# Once saved in the panel, the database values take precedence.
NEXT_PUBLIC_STATICALLY_OPTIMIZE_MEDIA=1
NEXT_PUBLIC_STATICALLY_OPTIMIZE_MEDIA_OG_IMAGES=0
NEXT_PUBLIC_STATICALLY_OPTIMIZE_MEDIA_CATEGORIES=1
NEXT_PUBLIC_STATICALLY_OPTIMIZE_MEDIA_CATEGORY_OG_IMAGES=0

# Categories and sorting
NEXT_PUBLIC_CATEGORY_VISIBILITY=recents,albums,tags,years,cameras,lenses
NEXT_PUBLIC_HIDE_CATEGORIES_ON_MOBILE=0
NEXT_PUBLIC_HIDE_CATEGORY_IMAGE_HOVERS=0
NEXT_PUBLIC_EXHAUSTIVE_SIDEBAR_CATEGORIES=0
NEXT_PUBLIC_HIDE_TAGS_WITH_ONE_MEDIA=0
NEXT_PUBLIC_DEFAULT_SORT=
NEXT_PUBLIC_PRIORITY_BASED_SORTING=0
NEXT_PUBLIC_COLOR_SORT=0
NEXT_PUBLIC_COLOR_SORT_STARTING_HUE=
NEXT_PUBLIC_COLOR_SORT_CHROMA_CUTOFF=
NEXT_PUBLIC_NAV_SORT_CONTROL=

# Display and grid
NEXT_PUBLIC_HIDE_KEYBOARD_SHORTCUT_TOOLTIPS=0
NEXT_PUBLIC_HIDE_EXIF_DATA=0
NEXT_PUBLIC_HIDE_ZOOM_CONTROLS=0
NEXT_PUBLIC_HIDE_TAKEN_AT_TIME=0
NEXT_PUBLIC_HIDE_REPO_LINK=0
NEXT_PUBLIC_GRID_HOMEPAGE=0
NEXT_PUBLIC_GRID_ASPECT_RATIO=1
NEXT_PUBLIC_SHOW_LARGE_THUMBNAILS=0

# Design, privacy, downloads, social, and feeds
NEXT_PUBLIC_DEFAULT_THEME=system
NEXT_PUBLIC_MATTE_MEDIA=0
NEXT_PUBLIC_MATTE_COLOR=
NEXT_PUBLIC_MATTE_COLOR_DARK=
NEXT_PUBLIC_GEO_PRIVACY=0
NEXT_PUBLIC_ALLOW_PUBLIC_DOWNLOADS=0
NEXT_PUBLIC_SOCIAL_NETWORKS=
NEXT_PUBLIC_SITE_FEEDS=0
NEXT_PUBLIC_OG_TEXT_ALIGNMENT=

# Scripts, Vercel automation, and diagnostics
PAGE_SCRIPT_URLS=
VERCEL_AUTOMATION_BYPASS_SECRET=
ADMIN_DEBUG_TOOLS=0
ADMIN_SQL_DEBUG=0
ANALYZE=false

# ============================================================================
# LEGACY ALIASES - SUPPORTED FOR EXISTING DEPLOYMENTS; LEAVE BLANK WHEN USING
# THE CANONICAL VARIABLES ABOVE
# ============================================================================
NEXTAUTH_SECRET=
CLOUDFLARE_WORKER_SHARED_SECRET=
RESEND_FROM=
TEXT_LK_API_TOKEN=
TEXT_LK_SENDER_ID=
NEXT_PUBLIC_SITE_DOMAIN=
NEXT_PUBLIC_SITE_DESCRIPTION=
NEXT_PUBLIC_SITE_TITLE=
NEXT_PUBLIC_SITE_ABOUT=
NEXT_PUBLIC_STATICALLY_OPTIMIZE_PAGES=
NEXT_PUBLIC_STATICALLY_OPTIMIZE_OG_IMAGES=
NEXT_PUBLIC_PRO_MODE=
NEXT_PUBLIC_HIDE_SOCIAL=
