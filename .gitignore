# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/workers/*/node_modules/
/workers/*/.wrangler/
/workers/*/.cf-dryrun/
/workers/*/.dev.vars
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# environment files (keep templates under version control)
.env
.env.*
!.env.example
!.env.*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temp files
temp.jpg
temp_patch_helper.txt
.next-dev.log

# local editor and Codex workspace state
.vscode/
.codex/

# python
__pycache__/
*.py[cod]
/tools/media-panel-folder-uploader/upload-data.json
/tools/media-panel-folder-uploader/upload-data.json.tmp
/tools/media-panel-folder-uploader/upload-data.json.bak
/tools/media-panel-folder-uploader/upload-data.json.lock
/tools/media-panel-folder-uploader/uploader-settings.json
/tools/media-panel-folder-uploader/uploader-settings.json.tmp
/tools/media-panel-folder-uploader/credentials.json
/tools/media-panel-folder-uploader/credentials.json.tmp
/tools/media-panel-folder-uploader/credentials.json.bak
