# Backend Orchestrator deployment bootstrap
#
# Cloudflare Workers Builds configuration:
#   Build command: leave empty
#   Deploy command: npm run deploy
#   Root directory:
#     - standalone media-panel-worker repository: leave empty
#     - embedded media-panel repository: workers/backend-orchestrator
#
# Add the two values below under Settings > Build > Build Variables and
# Secrets. Adding them only under runtime Variables & Secrets is not enough
# for the deployment script.
MEDIA_PANEL_BASE_URL=https://your-panel.vercel.app
BACKEND_ORCHESTRATOR_SHARED_SECRET=replace-with-a-long-random-secret

# The deployment script retrieves database, storage, processor authentication,
# and runtime settings from the panel. Do not duplicate those values here.
