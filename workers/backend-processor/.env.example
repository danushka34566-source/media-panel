# Required: Backend Processor -> Backend Orchestrator connection
BACKEND_ORCHESTRATOR_BASE_URL=https://your-orchestrator.workers.dev
BACKEND_PROCESSOR_SHARED_SECRET=replace-with-a-long-random-secret

# Optional processor identity and execution mode
BACKEND_PROCESSOR_ID=
RUN_ONCE=0

# Polling, heartbeat, and claim settings are received from the Backend
# Orchestrator and are managed in the panel Configuration page.
